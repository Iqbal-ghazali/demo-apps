# Copy to .env and fill in YOUR OWN credentials. Never commit .env.

# Claude — option A (subscription): run `claude setup-token` and paste the token here
CLAUDE_CODE_OAUTH_TOKEN=

# Claude — option B (API key, pay per use)
# ANTHROPIC_API_KEY=

# Codex — option A (ChatGPT login): leave empty; log in once inside the container
# Codex — option B (API key, pay per use)
# OPENAI_API_KEY=

# Optional shipping to GitHub Pages (see ship-template/README.md). Fine-grained token for ONE repo:
# Contents: read and write, Workflows: read and write, Actions: read, Pages: read.
# GITHUB_TOKEN=
# GITHUB_REPO=your-name/portfolio-site
